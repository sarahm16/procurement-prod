generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model ActivityLog {
  id             Int         @id(map: "PK__Activity__3213E83F261F0A47") @default(autoincrement())
  entity_type_id Int
  entity_id      Int
  field_changed  String?     @db.VarChar(100)
  previous_value String?     @db.NVarChar(500)
  new_value      String?     @db.NVarChar(500)
  changed_by     String?     @db.VarChar(100)
  changed_at     DateTime?   @default(now(), map: "DF__ActivityL__chang__6FB49575") @db.DateTime
  EntityTypes    EntityTypes @relation(fields: [entity_type_id], references: [id], onUpdate: NoAction, map: "FK__ActivityL__entit__70A8B9AE")

  @@index([entity_type_id, entity_id], map: "IX_ActivityLog_Entity")
}

model Clients {
  id                    Int                     @id(map: "PK__Clients__3213E83F189F30A2") @default(autoincrement())
  client                String                  @db.VarChar(100)
  mailing_address       String?                 @db.VarChar(150)
  mailing_address2      String?                 @db.VarChar(150)
  mailing_city          String?                 @db.VarChar(100)
  mailing_state         String?                 @db.Char(2)
  mailing_zipcode       String?                 @db.VarChar(10)
  lat                   Int?
  lng                   Int?
  billing_address       String?                 @db.VarChar(150)
  billing_address2      String?                 @db.VarChar(150)
  billing_city          String?                 @db.VarChar(100)
  billing_state         String?                 @db.Char(2)
  billing_zipcode       String?                 @db.VarChar(10)
  ClientServiceLines    ClientServiceLines[]
  ClientServiceLineSOWs ClientServiceLineSOWs[]
  Companies             Companies[]
  Sites                 Sites[]
}

model ClientServiceLines {
  client_id       Int
  service_line_id Int
  Clients         Clients       @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__clien__47A6A41B")
  ServiceLines   ServiceLines @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__servi__489AC854")

  @@id([client_id, service_line_id], map: "PK_ClientServiceLines")
}

model ClientServiceLineSOWs {
  client_id                     Int
  service_line_id               Int
  pandadoc_content_library_uuid String        @db.VarChar(100)
  description                   String?       @db.VarChar(200)
  Clients                       Clients       @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__clien__6BE40491")
  ServiceLines                 ServiceLines @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__servi__6CD828CA")

  @@id([client_id, service_line_id], map: "PK_ClientServiceLineSOWs")
}

model Companies {
  id        Int      @id(map: "PK__Companie__3213E83FBC38A215") @default(autoincrement())
  company   String   @db.VarChar(100)
  client_id Int?
  Clients   Clients? @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Companies__clien__3E1D39E1")
  Sites     Sites[]
}

model Employees {
  id                                                  Int                 @id(map: "PK__Employee__3213E83F5DB792B8") @default(autoincrement())
  ms_user_id                                          String              @db.VarChar(100)
  name                                                String?             @db.VarChar(100)
  email                                               String?             @db.VarChar(100)
  WorkOrders_WorkOrders_project_manager_idToEmployees WorkOrders[]        @relation("WorkOrders_project_manager_idToEmployees")
  WorkOrders_WorkOrders_sourcer_idToEmployees         WorkOrders[]        @relation("WorkOrders_sourcer_idToEmployees")
  WorkOrderServices                                   WorkOrderServices[]
}

model EntityTypes {
  id          Int           @id(map: "PK__EntityTy__3213E83FE1719A23") @default(autoincrement())
  name        String        @db.VarChar(50)
  ActivityLog ActivityLog[]
}

model ServiceLines {
  id                          Int                           @id(map: "PK__Service___3213E83F8FFD9AE8") @default(autoincrement())
  name                        String                        @db.VarChar(100)
  sarlaccId                   Int?                           
  ClientServiceLines          ClientServiceLines[]
  ClientServiceLineSOWs       ClientServiceLineSOWs[]
  ServiceLineExhibitTemplates ServiceLineExhibitTemplates[]
  SiteServiceLines            SiteServiceLines[]
  VendorSiteServiceLines      VendorSiteServiceLines[]
  ServiceLineServices         ServiceLineServices[]
}

model ServiceLineServices {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @db.VarChar(100)
  service_line_id             Int
  ServiceLine                 ServiceLines @relation(fields: [service_line_id], references: [id])                           
}

model ServiceLineExhibitTemplates {
  id                   Int           @id(map: "PK__ServiceL__3213E83F2716E9C4") @default(autoincrement())
  service_line_id      Int
  pandadoc_template_id String        @db.VarChar(100)
  ServiceLines        ServiceLines @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__ServiceLi__servi__690797E6")
}

model Sites {
  id                     Int                      @id(map: "PK__Sites__3213E83F412421E7") @default(autoincrement())
  store                  String?                  @db.VarChar(100)
  mailing_address        String?                  @db.VarChar(150)
  mailing_address2       String?                  @db.VarChar(150)
  mailing_city           String?                  @db.VarChar(100)
  mailing_state          String?                  @db.Char(2)
  mailing_zipcode        String?                  @db.VarChar(10)
  lat                    Int?
  lng                    Int?
  client_id              Int
  company_id             Int?
  Clients                Clients                  @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "FK__Sites__client_id__40F9A68C")
  Companies              Companies?               @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Sites__company_i__41EDCAC5")
  SiteServiceLines       SiteServiceLines[]
  VendorSites            VendorSites[]
  VendorSiteServiceLines VendorSiteServiceLines[]
  WorkOrders             WorkOrders[]
}

model SiteServiceLines {
  site_id         Int
  service_line_id Int
  ServiceLines   ServiceLines @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__SiteServi__servi__4C6B5938")
  Sites           Sites         @relation(fields: [site_id], references: [id], onUpdate: NoAction, map: "FK__SiteServi__site___4B7734FF")

  @@id([site_id, service_line_id], map: "PK_SiteServiceLines")
}

model Trades {
  id           Int            @id(map: "PK__Trades__3213E83FB5206A3D") @default(autoincrement())
  name         String         @db.VarChar(100)
  description  String?        @db.VarChar(200)
  sarlaccId    Int?
  VendorTrades VendorTrades[]
  WorkOrders   WorkOrders[]
}

model Vendors {
  id                     Int                      @id(map: "PK__Vendors__3213E83F06619C60") @default(autoincrement())
  company                String                   @db.VarChar(100)
  mailing_address        String?                  @db.VarChar(150)
  mailing_address2       String?                  @db.VarChar(150)
  mailing_city           String?                  @db.VarChar(100)
  mailing_state          String?                  @db.Char(2)
  mailing_zipcode        String?                  @db.VarChar(10)
  lat                    Int?
  lng                    Int?
  billing_address        String?                  @db.VarChar(150)
  billing_address2       String?                  @db.VarChar(150)
  billing_city           String?                  @db.VarChar(100)
  billing_state          String?                  @db.Char(2)
  billing_zipcode        String?                  @db.VarChar(10)
  status_id              Int?
  VendorStatuses         VendorStatuses?          @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Vendors__status___44CA3770")
  VendorSites            VendorSites[]
  VendorSiteServiceLines VendorSiteServiceLines[]
  VendorTrades           VendorTrades[]
  WorkOrderServices      WorkOrderServices[]
}

model VendorSites {
  vendor_id Int
  site_id   Int
  Sites     Sites   @relation(fields: [site_id], references: [id], onUpdate: NoAction, map: "FK__VendorSit__site___503BEA1C")
  Vendors   Vendors @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, map: "FK__VendorSit__vendo__4F47C5E3")

  @@id([vendor_id, site_id], map: "PK_VendorSites")
}

model VendorSiteServiceLines {
  vendor_id          Int
  site_id            Int
  service_line_id    Int
  is_primary         Boolean            @default(false, map: "DF__VendorSit__is_pr__531856C7")
  status_id          Int
  ServiceLines      ServiceLines      @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__VendorSit__servi__55F4C372")
  Sites              Sites              @relation(fields: [site_id], references: [id], onUpdate: NoAction, map: "FK__VendorSit__site___55009F39")
  VendorSiteStatuses VendorSiteStatuses @relation(fields: [status_id], references: [id], onUpdate: NoAction, map: "FK__VendorSit__statu__56E8E7AB")
  Vendors            Vendors            @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, map: "FK__VendorSit__vendo__540C7B00")

  @@id([vendor_id, site_id, service_line_id], map: "PK_VendorSiteServiceLines")
}

model VendorSiteStatuses {
  id                     Int                      @id(map: "PK__VendorSi__3213E83F10849821") @default(autoincrement())
  name                   String                   @db.VarChar(50)
  category               String                   @db.VarChar(20)
  description            String?                  @db.VarChar(200)
  VendorSiteServiceLines VendorSiteServiceLines[]
}

model VendorStatuses {
  id          Int       @id(map: "PK__VendorSt__3213E83FAC107989") @default(autoincrement())
  name        String    @db.VarChar(50)
  description String?   @db.VarChar(200)
  Vendors     Vendors[]
}

model VendorTrades {
  vendor_id Int
  trade_id  Int
  Trades    Trades  @relation(fields: [trade_id], references: [id], onUpdate: NoAction, map: "FK__VendorTra__trade__5AB9788F")
  Vendors   Vendors @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, map: "FK__VendorTra__vendo__59C55456")

  @@id([vendor_id, trade_id], map: "PK_VendorTrades")
}

model WorkOrders {
  id                                                 Int                 @id(map: "PK__WorkOrde__3213E83FA1A0BFFC") @default(autoincrement())
  trade_id                                           Int
  site_id                                            Int
  project_manager_id                                 Int?
  sourcer_id                                         Int?
  status                                             String?             @db.VarChar(50)
  Employees_WorkOrders_project_manager_idToEmployees Employees?          @relation("WorkOrders_project_manager_idToEmployees", fields: [project_manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__WorkOrder__proje__5F7E2DAC")
  Sites                                              Sites               @relation(fields: [site_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__site___5E8A0973")
  Employees_WorkOrders_sourcer_idToEmployees         Employees?          @relation("WorkOrders_sourcer_idToEmployees", fields: [sourcer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__WorkOrder__sourc__607251E5")
  Trades                                             Trades              @relation(fields: [trade_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__trade__5D95E53A")
  WorkOrderServices                                  WorkOrderServices[]
}

model WorkOrderServices {
  id            Int        @id(map: "PK__WorkOrde__3213E83FF413C92F") @default(autoincrement())
  work_order_id Int
  vendor_id     Int?
  service       String?    @db.VarChar(200)
  client_price  Decimal?   @db.Decimal(10, 2)
  vendor_price  Decimal?   @db.Decimal(10, 2)
  is_upsell     Boolean    @default(false, map: "DF__WorkOrder__is_up__634EBE90")
  pm_id         Int?
  Employees     Employees? @relation(fields: [pm_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__WorkOrder__pm_id__662B2B3B")
  Vendors       Vendors?   @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__WorkOrder__vendo__65370702")
  WorkOrders    WorkOrders @relation(fields: [work_order_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__work___6442E2C9")
}

model Softwares {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(50)
}