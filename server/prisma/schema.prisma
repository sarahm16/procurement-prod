generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model ActivityLog {
  id             Int         @id(map: "PK__Activity__3213E83F261F0A47") @default(autoincrement())
  entity_type_id Int
  entity_id      Int
  action         String      @db.VarChar(50)   // CREATE, UPDATE, DELETE, ASSIGN, REMOVE
  field_changed  String?     @db.VarChar(100)
  previous_value String?     @db.NVarChar(500)
  new_value      String?     @db.NVarChar(500)
  changed_by     Int         // FK to Employee.id
  changed_at     DateTime?   @default(now(), map: "DF__ActivityL__chang__6FB49575") @db.DateTime
  
  Employee       Employees    @relation(fields: [changed_by], references: [id], onUpdate: NoAction, onDelete: NoAction)
  EntityType     EntityTypes @relation(fields: [entity_type_id], references: [id], onUpdate: NoAction, map: "FK__ActivityL__entit__70A8B9AE")

  @@index([entity_type_id, entity_id], map: "IX_ActivityLog_Entity")
}

model Clients {
  created_at            DateTime                @default(now())

  id                    Int                     @id(map: "PK__Clients__3213E83F189F30A2") @default(autoincrement())
  client                String                  @db.VarChar(100)
  legal_name            String                  @db.VarChar(100)    // new
  status                String                  @db.VarChar(20)
  brand                 String                  @db.VarChar(4)      // new
  sarlaccId             String?                 @db.VarChar(100)    // new
  tax_treatment         String                  @db.VarChar(30)   @default("Billed separately")
  sandbox               Boolean                @default(false)

  mailing_address       String?                 @db.VarChar(150)
  mailing_address2      String?                 @db.VarChar(150)
  mailing_city          String?                 @db.VarChar(100)
  mailing_state         String?                 @db.VarChar(50)
  mailing_zipcode       String?                 @db.VarChar(10)
  lat                   Decimal?
  lng                   Decimal?
  billing_address       String?                 @db.VarChar(150)
  billing_address2      String?                 @db.VarChar(150)
  billing_city          String?                 @db.VarChar(100)
  billing_state         String?                 @db.VarChar(50)
  billing_zipcode       String?                 @db.VarChar(10)

  account_manager_id    Int?      

  AccountManager        Employees?              @relation("ClientAccountManager", fields: [account_manager_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  ClientServiceLines    ClientServiceLines[]
  ClientServiceLineSOWs ClientServiceLineSOWs[]
  Companies             Companies[]
  Sites                 Sites[]
  Contracts             Contracts[]
  Contacts              ClientContacts[]

  
}

model ContactRoles {
  created_at            DateTime                @default(now())

  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(50)

  ClientContacts      ClientContacts[]
  SiteContacts        SiteContacts[]
  VendorContacts      VendorContacts[]
}

model ClientContacts {
  created_at            DateTime                @default(now())

  id                  Int       @id @default(autoincrement())
  name                 String   @db.VarChar(100)
  email                String?  @db.VarChar(100)
  phone                String?  @db.VarChar(100)
  client_id            Int    
  contact_role_id         Int

  ContactRole        ContactRoles      @relation(fields: [contact_role_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Client              Clients          @relation(fields: [client_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

}

model SiteContacts {
  created_at            DateTime                @default(now())

  id                   Int       @id @default(autoincrement())
  name                 String   @db.VarChar(100)
  email                String?  @db.VarChar(100)
  phone                String?  @db.VarChar(100)
  site_id              Int    
  contact_role_id      Int

  ContactRole        ContactRoles      @relation(fields: [contact_role_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Site                Sites          @relation(fields: [site_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

}

model ClientServiceLines {
  created_at            DateTime                @default(now())

  client_id       Int
  service_line_id Int

  Client          Clients       @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__clien__47A6A41B")
  ServiceLine     ServiceLines @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__servi__489AC854")

  @@id([client_id, service_line_id], map: "PK_ClientServiceLines")
}

model ClientServiceLineSOWs {
  created_at            DateTime                @default(now())

  client_id                     Int
  service_line_id               Int
  pandadoc_content_library_uuid String        @db.VarChar(100)
  description                   String?       @db.VarChar(200)
  Client                        Clients       @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__clien__6BE40491")
  ServiceLine                   ServiceLines @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__ClientSer__servi__6CD828CA")

  @@id([client_id, service_line_id], map: "PK_ClientServiceLineSOWs")
}

model Companies {
  created_at            DateTime                @default(now())

  id            Int      @id(map: "PK__Companie__3213E83FBC38A215") @default(autoincrement())
  company       String   @db.VarChar(100)
  client_id     Int?
  Client        Clients? @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Companies__clien__3E1D39E1")
  Sites         Sites[]
}

model Employees {
  id                            Int                 @id(map: "PK__Employee__3213E83F5DB792B8") @default(autoincrement())
  ms_user_id                    String              @db.VarChar(100)  @unique
  name                          String             @db.VarChar(100)
  email                         String             @db.VarChar(100)
  role_id                       Int
  terminated                    Boolean             @default(false)

  ManagedWorkOrders             WorkOrders[]        @relation("ProjectManager")
  SourcedWorkOrders             WorkOrders[]        @relation("Sourcer")
  Role                          Roles               @relation(fields: [role_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  TaggedInNotes                 NoteTaggedUsers[]   @relation("NoteTaggedUser")
  AuthoredNotes                 Notes[]             @relation("NoteAuthor")
  ActivityLog                   ActivityLog[]
  ContractSalesPerson           Contracts[]         @relation("ContractSalesPerson")
  ContractOperationsPerson      Contracts[]         @relation("ContractOperationsPerson")
  ClientAccountManager          Clients[]           @relation("ClientAccountManager")
  RoleAssignments               RoleAssignments[]   
} 

model InternalRoles {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)   // "Account Manager", "Coordinator", "Sales"
  description   String?  @db.VarChar(100)
  // optionally: description, active flag

  RoleAssignments  RoleAssignments[]
  RoleEntityType   RoleEntityTypes[]
}

model RoleAssignments {
  id              Int      @id @default(autoincrement())
  employee_id     Int
  
  internal_role_id         Int
  entity_type_id  Int      // which model: Clients, Sites, Contracts...
  entity_id       Int      // which row of that model
  created_at      DateTime @default(now())

  Role            InternalRoles  @relation(fields: [internal_role_id], references: [id])
  // employee is your synced Employees table
  Employee        Employees      @relation(fields: [employee_id], references: [id])

  @@index([entity_type_id, entity_id])   // "who's assigned to this client"
  @@index([employee_id])                  // "what is this employee assigned to"
}

model RoleEntityTypes {
  id              Int      @id @default(autoincrement())
  internal_role_id         Int
  entity_type_id  Int

  InternalRole            InternalRoles  @relation(fields: [internal_role_id], references: [id])

  @@unique([internal_role_id, entity_type_id])   // a role applies to an entity type once
}

model Roles {
  created_at            DateTime                @default(now())

  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(50)
  description   String?       @db.VarChar(100)

  Employees     Employees[]
}

model EntityTypes {
  id            Int           @id(map: "PK__EntityTy__3213E83FE1719A23") @default(autoincrement())
  name          String        @db.VarChar(50)

  ActivityLog   ActivityLog[]
  Notes         Notes[]
}

model ServiceLines {
  id                          Int                           @id(map: "PK__Service___3213E83F8FFD9AE8") @default(autoincrement())
  name                        String                        @db.VarChar(100)
  sarlaccId                   Int?                          @unique

  ClientServiceLines          ClientServiceLines[]
  ClientServiceLineSOWs       ClientServiceLineSOWs[]
  ServiceLineExhibitTemplates ServiceLineExhibitTemplates[]
  ServiceLineServices         ServiceLineServices[]
  Contracts                   Contracts[]
}

model ServiceLineServices {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @db.VarChar(100)
  service_line_id             Int
  ServiceLine                 ServiceLines @relation(fields: [service_line_id], references: [id])                           

  ContractSiteServices        ContractSiteServices[]

}

model ServiceLineExhibitTemplates {
  id                   Int           @id(map: "PK__ServiceL__3213E83F2716E9C4") @default(autoincrement())
  service_line_id      Int
  pandadoc_template_id String        @db.VarChar(100)

  ServiceLine          ServiceLines @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, map: "FK__ServiceLi__servi__690797E6")
}

model Sites {
  created_at            DateTime                @default(now())

  id                     Int                      @id(map: "PK__Sites__3213E83F412421E7") @default(autoincrement())
  store                  String?                  @db.VarChar(100)
  mailing_address        String?                  @db.VarChar(150)
  mailing_address2       String?                  @db.VarChar(150)
  mailing_city           String?                  @db.VarChar(100)
  mailing_state          String?                  @db.VarChar(50)
  mailing_zipcode        String?                  @db.VarChar(10)
  lat                    Decimal?
  lng                    Decimal?
  client_id              Int
  company_id             Int?
  sandbox                Boolean                  @default(false)


  Client                 Clients                  @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "FK__Sites__client_id__40F9A68C")
  Company                Companies?               @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Sites__company_i__41EDCAC5")
  WorkOrders             WorkOrders[]
  ContractSites          ContractSites[]
  Contacts               SiteContacts[]
}

model Trades {
  id           Int            @id(map: "PK__Trades__3213E83FB5206A3D") @default(autoincrement())
  name         String         @db.VarChar(100)
  description  String?        @db.VarChar(200)
  sarlaccId    Int?          

  VendorTrades VendorTrades[]
  WorkOrders   WorkOrders[]
}

model Vendors {
  created_at            DateTime                @default(now())

  id                     Int                      @id(map: "PK__Vendors__3213E83F06619C60") @default(autoincrement())
  sarlaccId              String?                  @db.VarChar(50)
  company                String                   @db.VarChar(100)
  sandbox                Boolean                  @default(false)
  contact_name           String?                  @db.VarChar(100)
  contact_phone          String?                  @db.VarChar(20)
  contact_phone2         String?                  @db.VarChar(20)
  contact_email          String?                  @db.VarChar(100)
  quickbooks_id          String?                  @db.VarChar(100)
  mailing_address        String?                  @db.VarChar(150)
  mailing_address2       String?                  @db.VarChar(150)
  mailing_city           String?                  @db.VarChar(100)
  mailing_state          String?                  @db.VarChar(50)
  mailing_zipcode        String?                  @db.VarChar(10)
  lat                    Decimal?
  lng                    Decimal?
  billing_address        String?                  @db.VarChar(150)
  billing_address2       String?                  @db.VarChar(150)
  billing_city           String?                  @db.VarChar(100)
  billing_state          String?                  @db.VarChar(50)
  billing_zipcode        String?                  @db.VarChar(10)

  status_id              Int

  VendorStatus           VendorStatuses           @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Vendors__status___44CA3770")
  
  ContractSites          VendorContractSites[]
  VendorTrades           VendorTrades[]
  WorkOrderServices      WorkOrderServices[]
  VendorServicePricing   VendorServicePricing[]
  Contacts               VendorContacts[]
}

model VendorContacts {
  created_at            DateTime                @default(now())

  id                   Int       @id @default(autoincrement())
  name                 String   @db.VarChar(100)
  email                String?  @db.VarChar(100)
  phone                String?  @db.VarChar(100)
  vendor_id            Int    
  contact_role_id      Int

  ContactRole        ContactRoles      @relation(fields: [contact_role_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Vendor             Vendors           @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

}

model VendorContractSites {
  created_at            DateTime                @default(now())

  id                Int       @id @default(autoincrement())
  is_primary        Boolean   @default(false)
  status_id         Int
  vendor_id         Int
  contract_site_id  Int

  Vendor            Vendors            @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  ContractSite      ContractSites      @relation(fields: [contract_site_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  VendorSiteStatus  VendorSiteStatuses @relation(fields: [status_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@index([contract_site_id])
  @@index([vendor_id])
}


model VendorSiteStatuses {
  id                     Int                      @id(map: "PK__VendorSi__3213E83F10849821") @default(autoincrement())
  name                   String                   @db.VarChar(50)
  category               String                   @db.VarChar(20)
  description            String?                  @db.VarChar(200)

  VendorContractSite     VendorContractSites[]
}

model VendorStatuses {
  id          Int       @id(map: "PK__VendorSt__3213E83FAC107989") @default(autoincrement())
  name        String    @db.VarChar(50)
  color       String    @db.VarChar(50)
  description String?   @db.VarChar(200)
  Vendors     Vendors[]
}


model VendorTrades {
  vendor_id Int
  trade_id  Int
  
  Trade     Trades  @relation(fields: [trade_id], references: [id], onUpdate: NoAction, map: "FK__VendorTra__trade__5AB9788F")
  Vendor    Vendors @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, map: "FK__VendorTra__vendo__59C55456")

  @@id([vendor_id, trade_id], map: "PK_VendorTrades")
}

model WorkOrders {
  created_at            DateTime                @default(now())

  id                        Int                 @id(map: "PK__WorkOrde__3213E83FA1A0BFFC") @default(autoincrement())

  trade_id                Int
  site_id                 Int
  project_manager_id      Int?
  sourcer_id              Int?
  status                  String?             @db.VarChar(50)

  Site                    Sites               @relation(fields: [site_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__site___5E8A0973")
  Trade                   Trades              @relation(fields: [trade_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__trade__5D95E53A")
  ProjectManager          Employees?          @relation("ProjectManager", fields: [project_manager_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Sourcer                 Employees?          @relation("Sourcer", fields: [sourcer_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  WorkOrderServices       WorkOrderServices[]
}

model WorkOrderServices {
  id            Int           @id(map: "PK__WorkOrde__3213E83FF413C92F") @default(autoincrement())
  
  work_order_id Int
  vendor_id     Int?

  service       String?       @db.VarChar(200)
  client_price  Decimal?      @db.Decimal(10, 2)
  vendor_price  Decimal?      @db.Decimal(10, 2)
  is_upsell     Boolean       @default(false, map: "DF__WorkOrder__is_up__634EBE90")
  
  Vendors       Vendors?      @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__WorkOrder__vendo__65370702")
  WorkOrders    WorkOrders    @relation(fields: [work_order_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__work___6442E2C9")
}

model Softwares {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(50)

  Contracts     Contracts[]
}

model Contracts {
  created_at            DateTime                @default(now())

  id                      Int         @id @default(autoincrement())
  start_date              DateTime    @default(now()) @db.DateTime
  end_date                DateTime?   @db.DateTime
  auto_renew              Boolean     @default(false)
  annual_increase_percent Decimal?        
  value                   Decimal
  project_name            String


  client_id               Int
  service_line_id         Int
  software_id             Int?  
  sales_person_id         Int?
  operations_person_id    Int?
  service_type_id         Int?

  ServiceLine             ServiceLines    @relation(fields: [service_line_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Client                  Clients         @relation(fields: [client_id], references: [id], onUpdate: NoAction, onDelete: NoAction)            
  Software                Softwares?      @relation(fields: [software_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  SalesPerson             Employees?      @relation("ContractSalesPerson", fields: [sales_person_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  OperationsPerson        Employees?      @relation("ContractOperationsPerson", fields: [operations_person_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  ServiceType             ServiceTypes?          @relation(fields: [service_type_id], references: [id], onUpdate: NoAction, onDelete: NoAction)


  ContractSites                   ContractSites[]
}

model ServiceTypes {
  id                      Int       @id @default(autoincrement())
  name                    String    @db.VarChar(100)
  description             String?   @db.VarChar(300)
  
  Contracts               Contracts[]
}

model ContractSites {
  created_at            DateTime                @default(now())

  id              Int       @id @default(autoincrement())
  high_risk       Boolean   @default(false)
  site_id         Int
  contract_id     Int

  Site                    Sites                   @relation(fields: [site_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Contract                Contracts               @relation(fields: [contract_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  ContractSiteServices    ContractSiteServices[]  

  @@unique([contract_id, site_id])
  VendorContractSites     VendorContractSites[]
}

model ContractSiteServices {
  id                        Int       @id @default(autoincrement())
  client_price              Decimal   @default(0)

  contract_site_id          Int
  service_type_id           Int
  service_line_service_id   Int

  ContractSite              ContractSites         @relation(fields: [contract_site_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  ServiceLineService        ServiceLineServices   @relation(fields: [service_line_service_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
    
  VendorServicePricing      VendorServicePricing?
}

model VendorServicePricing {
  created_at            DateTime                @default(now())

  id                          Int   @id @default(autoincrement())
  vendor_price                Decimal

  contract_site_service_id    Int   @unique
  vendor_id                   Int

  ContractSiteServices        ContractSiteServices    @relation(fields: [contract_site_service_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Vendor                      Vendors                 @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

}

model Notes {
    created_at            DateTime                @default(now())

    id                          Int               @id @default(autoincrement())
    body                        String            @db.VarChar(1000)
    date                        DateTime          @default(now())
    sarlaccId                   String?           @db.VarChar(50)
    priority                    String            @db.VarChar(10) @default("Low")

    author_id                   Int
    entity_type_id              Int
    entity_id                   Int
    parent_note_id              Int?

    Author                      Employees         @relation("NoteAuthor", fields: [author_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
    EntityType                  EntityTypes       @relation(fields: [entity_type_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
    ParentNote                  Notes?            @relation("NoteReplies", fields: [parent_note_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
    Replies                     Notes[]           @relation("NoteReplies")
    NoteTaggedUsers             NoteTaggedUsers[]


    @@index([entity_type_id, entity_id])
}

model NoteTaggedUsers {
  id                          Int     @id @default(autoincrement())

  note_id                     Int
  tagged_user_id              Int

  Note                        Notes       @relation(fields: [note_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  TaggedUser                  Employees   @relation("NoteTaggedUser", fields: [tagged_user_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([note_id, tagged_user_id])
  @@index([tagged_user_id])
}
