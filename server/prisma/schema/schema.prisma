generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "views"]
}

/// Only active and upcoming lines — removed and ended ones drop out.
view SourcingGrid {
  contract_site_id        Int       @id
  line_status             String    // active | upcoming
  starts_on               DateTime? @db.Date
  ends_on                 DateTime? @db.Date

  site_id                 Int
  store                   String?
  mailing_city            String?
  mailing_state           String?
  site_lat                Decimal?
  site_lng                Decimal?

  client_id               Int?
  client                  String?

  service_line_id         Int
  service_line            String

  /// One row per ContractSite. The assignment, vendor and progress columns
  /// describe the primary vendor (or the newest live one if none is marked).
  /// Backups are counted here and listed in full by SourcingGridVendors.
  /// Definition: prisma/sql/vw_SourcingGrid.sql
  assignment_id           Int?
  assignment_status_id    Int?
  is_primary              Boolean?
  assigned_at             DateTime?
  vendor_count            Int
  backup_vendor_count     Int

  vendor_id               Int?
  company                 String?
  vendor_lat              Decimal?
  vendor_lng              Decimal?
  vendor_status_id        Int?

  has_w9                  Boolean
  has_coi                 Boolean
  has_msa                 Boolean
  has_ach                 Boolean
  coi_expiration          DateTime?

  service_count           Int
  priced_count            Int
  has_rates               Boolean

  exhibit_sent_at         DateTime?
  exhibit_signed_at       DateTime?
  exhibit_sent            Boolean
  exhibit_signed          Boolean

  client_price_total      Decimal?
  vendor_price_total      Decimal?

  is_sourced              Boolean
  completed_steps         Int       @db.TinyInt

  @@map("vw_SourcingGrid")
}

/// Every vendor assigned to a ContractSite (primary and backups), one row per
/// VendorContractSites row, with the same seven checks as SourcingGrid.
/// Includes closed assignments; filter assignment_status_category for the
/// live list. Definition: prisma/sql/vw_SourcingGridVendors.sql
view SourcingGridVendors {
  assignment_id              Int       @id
  contract_site_id           Int
  is_primary                 Boolean
  assignment_status_id       Int
  assignment_status_category String
  assigned_at                DateTime

  vendor_id                  Int
  company                    String
  vendor_lat                 Decimal?
  vendor_lng                 Decimal?
  vendor_status_id           Int

  has_w9                     Boolean
  has_coi                    Boolean
  has_msa                    Boolean
  has_ach                    Boolean
  coi_expiration             DateTime?

  service_count              Int
  priced_count               Int
  has_rates                  Boolean

  exhibit_sent_at            DateTime?
  exhibit_signed_at          DateTime?
  exhibit_sent               Boolean
  exhibit_signed             Boolean

  vendor_price_total         Decimal?

  is_sourced                 Boolean
  completed_steps            Int       @db.TinyInt

  @@map("vw_SourcingGridVendors")
}

/// One row per contract site: its status, worked out from the contract's and
/// the site's dates. Definition: prisma/sql/vw_ServiceLineStatus.sql
view ServiceLineStatus {
  contract_site_id Int       @id
  site_id          Int
  contract_id      Int
  client_id        Int
  service_line_id  Int
  service_line     String
  project_name     String
  /// active | upcoming | removed | contract_ended
  status           String
  is_active        Boolean
  /// active or upcoming — what the sourcing grid shows
  is_current       Boolean
  /// The later of the contract's and the site's start dates
  starts_on        DateTime? @db.Date
  /// The earlier of the two end dates (null = open-ended)
  ends_on          DateTime? @db.Date

  @@map("vw_ServiceLineStatus")
}

/// One row per site, rolled up from ServiceLineStatus.
///   active    at least one line is active
///   upcoming  nothing active yet, but at least one line is starting
///   inactive  every line has ended or been removed
///   none      the site has never been on a contract
/// Definition: prisma/sql/vw_SiteStatus.sql
view SiteStatus {
  site_id         Int       @id
  status          String
  active_lines    Int
  upcoming_lines  Int
  ended_lines     Int
  total_lines     Int
  next_start_date DateTime? @db.Date
  last_end_date   DateTime? @db.Date

  @@map("vw_SiteStatus")
}

/// One row per contract: its status from its own dates.
/// Definition: prisma/sql/vw_ContractStatus.sql
view ContractStatus {
  contract_id     Int       @id
  client_id       Int
  service_line_id Int
  service_line    String
  project_name    String
  /// active | upcoming | ended
  status          String
  is_active       Boolean
  /// active or upcoming
  is_current      Boolean
  auto_renew      Boolean
  starts_on       DateTime? @db.Date
  /// null when open-ended or auto-renewing
  ends_on         DateTime? @db.Date

  @@map("vw_ContractStatus")
}

/// One row per client, rolled up from ContractStatus, with the manual pause
/// on top.
///   status           paused | active | upcoming | inactive | none
///   contract_status  the same without the pause — what the contracts say
/// Definition: prisma/sql/vw_ClientStatus.sql
view ClientStatus {
  client_id          Int       @id
  status             String
  contract_status    String
  active_contracts   Int
  upcoming_contracts Int
  ended_contracts    Int
  total_contracts    Int
  next_start_date    DateTime? @db.Date
  last_end_date      DateTime? @db.Date
  paused_at          DateTime? @db.Date
  paused_reason      String?

  @@map("vw_ClientStatus")
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}