generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "views"]
}

view SourcingGrid {
  contract_site_id        Int       @id
  contract_site_status_id Int

  site_id                 Int
  store                   String?
  mailing_city            String?
  mailing_state           String?
  site_lat                Decimal?
  site_lng                Decimal?

  client_id               Int?
  client                  String?

  service_line_id         Int
  service_line            String

  assignment_id           Int?
  assignment_status_id    Int?
  is_primary              Boolean?
  assigned_at             DateTime?

  vendor_id               Int?
  company                 String?
  vendor_lat              Decimal?
  vendor_lng              Decimal?
  vendor_status_id        Int?

  has_w9                  Boolean
  has_coi                 Boolean
  has_msa                 Boolean
  has_ach                 Boolean
  coi_expiration          DateTime?

  service_count           Int
  priced_count            Int
  has_rates               Boolean

  exhibit_sent_at         DateTime?
  exhibit_signed_at       DateTime?
  exhibit_sent            Boolean
  exhibit_signed          Boolean

  client_price_total      Decimal?
  vendor_price_total      Decimal?

  is_sourced              Boolean
  completed_steps         Int       @db.TinyInt

  @@map("vw_SourcingGrid")
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}
