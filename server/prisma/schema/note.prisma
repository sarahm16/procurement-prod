model Notes {
  id              Int               @id @default(autoincrement())
  body            String            @db.VarChar(1000)
  date            DateTime          @default(now())
  sarlaccId       String?           @db.VarChar(50)
  priority        String            @default("Low") @db.VarChar(10)
  entity_type_id  Int
  entity_id       Int
  parent_note_id  Int?
  author_id       Int
  created_at      DateTime          @default(now())
  Author          Employees         @relation("NoteAuthor", fields: [author_id], references: [id], onUpdate: NoAction)
  EntityType      EntityTypes       @relation(fields: [entity_type_id], references: [id], onUpdate: NoAction)
  ParentNote      Notes?            @relation("NoteReplies", fields: [parent_note_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Replies         Notes[]           @relation("NoteReplies")
  NoteTaggedUsers NoteTaggedUsers[]

  @@index([entity_type_id, entity_id])
}

model NoteTaggedUsers {
  id             Int       @id @default(autoincrement())
  note_id        Int
  tagged_user_id Int
  Note           Notes     @relation(fields: [note_id], references: [id], onUpdate: NoAction)
  TaggedUser     Employees @relation("NoteTaggedUser", fields: [tagged_user_id], references: [id], onUpdate: NoAction)

  @@unique([note_id, tagged_user_id])
  @@index([tagged_user_id])
}
