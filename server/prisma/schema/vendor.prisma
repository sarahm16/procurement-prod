model Vendors {
  id                      Int                         @id(map: "PK__Vendors__3213E83F06619C60") @default(autoincrement())
  company                 String                      @db.VarChar(100)
  mailing_address         String?                     @db.VarChar(150)
  mailing_address2        String?                     @db.VarChar(150)
  mailing_city            String?                     @db.VarChar(100)
  mailing_state           String?                     @db.VarChar(50)
  mailing_zipcode         String?                     @db.VarChar(10)
  lat                     Decimal?                    @db.Decimal(9,6)
  lng                     Decimal?                    @db.Decimal(9,6)
  billing_address         String?                     @db.VarChar(150)
  billing_address2        String?                     @db.VarChar(150)
  billing_city            String?                     @db.VarChar(100)
  billing_state           String?                     @db.VarChar(50)
  billing_zipcode         String?                     @db.VarChar(10)
  status_id               Int
  sandbox                 Boolean                     @default(false)
  sarlaccId               String?                     @db.VarChar(50)
  contact_email           String?                     @db.VarChar(100)
  contact_name            String?                     @db.VarChar(100)
  contact_phone           String?                     @db.VarChar(20)
  contact_phone2          String?                     @db.VarChar(20)
  quickbooks_id           String?                     @db.VarChar(100)
  created_at              DateTime                    @default(now())
  COIs                    VendorCOIs[]
  ComplianceDocuments     VendorComplianceDocuments[]
  Contacts                VendorContacts[]
  ContractSites           VendorContractSites[]
  Exhibits                VendorExhibits[]
  VendorStatus            VendorStatuses              @relation(fields: [status_id], references: [id], onUpdate: NoAction, map: "FK__Vendors__status___44CA3770")
  VendorTrades            VendorTrades[]
  Warnings                VendorWarnings[]
  WorkOrderCommunications WorkOrderCommunications[]
  WorkOrderMSAs           WorkOrderMSAs[]
  WorkOrders              WorkOrders[]
  WorkOrderUpdates        WorkOrderVendorUpdates[]
}

model VendorContacts {
  created_at      DateTime     @default(now())
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(100)
  email           String?      @db.VarChar(100)
  phone           String?      @db.VarChar(100)
  vendor_id       Int
  contact_role_id Int
  ContactRole     ContactRoles @relation(fields: [contact_role_id], references: [id], onUpdate: NoAction)
  Vendor          Vendors      @relation(fields: [vendor_id], references: [id], onUpdate: NoAction)

  @@index([vendor_id])
}

model VendorContractSites {
  id                Int                @id @default(autoincrement())
  is_primary        Boolean            @default(false)
  status_id         Int
  vendor_id         Int
  contract_site_id  Int
  created_at        DateTime           @default(now())
  
  ContractSite      ContractSites      @relation(fields: [contract_site_id], references: [id], onUpdate: NoAction)
  VendorSiteStatus  VendorSiteStatuses @relation(fields: [status_id], references: [id], onUpdate: NoAction)
  Vendor            Vendors            @relation(fields: [vendor_id], references: [id], onUpdate: NoAction)

  ServicePricing    VendorServicePricing[]
  Exhibits          VendorExhibitContractSites[]

  @@index([contract_site_id])
  @@unique([vendor_id, contract_site_id])
}

model VendorSiteStatuses {
  id                 Int                   @id(map: "PK__VendorSi__3213E83F10849821") @default(autoincrement())
  name               String                @db.VarChar(50)
  category           String                @db.VarChar(20)
  description        String?               @db.VarChar(200)
  VendorContractSite VendorContractSites[]
}

model VendorStatuses {
  id          Int       @id(map: "PK__VendorSt__3213E83FAC107989") @default(autoincrement())
  name        String    @db.VarChar(50)
  description String?   @db.VarChar(200)
  color       String    @db.VarChar(50)
  Vendors     Vendors[]
}

model VendorTrades {
  vendor_id Int
  trade_id  Int
  Trade     Trades  @relation(fields: [trade_id], references: [id], onUpdate: NoAction, map: "FK__VendorTra__trade__5AB9788F")
  Vendor    Vendors @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, map: "FK__VendorTra__vendo__59C55456")

  @@id([vendor_id, trade_id], map: "PK_VendorTrades")
}

model VendorServicePricing {
  id                                     Int                      @id @default(autoincrement())
  vendor_price                           Decimal                  @db.Decimal(19,4)
  contract_site_service_id               Int                      
  vendor_contract_site_id                Int
  created_at                             DateTime                 @default(now())

  ContractSiteServices                   ContractSiteServices     @relation(fields: [contract_site_service_id], references: [id], onUpdate: NoAction)
  VendorContractSite                     VendorContractSites      @relation(fields: [vendor_contract_site_id], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@unique([ vendor_contract_site_id, contract_site_service_id])
  @@index([contract_site_service_id])
}

model VendorComplianceDocuments {
  id             Int        @id @default(autoincrement())
  vendor_id      Int
  document_type  String
  pandadoc_id    String?
  status         String
  date_sent      DateTime?
  date_completed DateTime?
  created_at     DateTime   @default(now())
  sent_by        Int?
  SentBy         Employees? @relation(fields: [sent_by], references: [id])
  Vendor         Vendors    @relation(fields: [vendor_id], references: [id])

  @@index([vendor_id, document_type])
}

model VendorExhibits {
  id              Int           @id @default(autoincrement())
  vendor_id       Int
  service_line_id Int?
  pandadoc_id     String?
  template_id     String?
  is_work_order   Boolean       @default(false)
  status          String
  date_sent       DateTime?
  date_completed  DateTime?
  created_at      DateTime      @default(now())
  ServiceLine     ServiceLines? @relation(fields: [service_line_id], references: [id])
  Vendor          Vendors       @relation(fields: [vendor_id], references: [id])

  ContractSites   VendorExhibitContractSites[]

  @@index([vendor_id])
}

model VendorExhibitContractSites {
  id                      Int                 @id @default(autoincrement())
  vendor_exhibit_id       Int
  vendor_contract_site_id Int
  created_at              DateTime            @default(now())

  VendorExhibit           VendorExhibits      @relation(fields: [vendor_exhibit_id], references: [id], onUpdate: NoAction, onDelete: Cascade)
  VendorContractSite      VendorContractSites @relation(fields: [vendor_contract_site_id], references: [id], onUpdate: NoAction)

  @@unique([vendor_exhibit_id, vendor_contract_site_id])
  @@index([vendor_contract_site_id])
}

model VendorCOIs {
  id                            Int       @id @default(autoincrement())
  vendor_id                     Int
  blob_url                      String    @db.VarChar(500)
  file_name                     String    @db.VarChar(255)
  expiration_date               DateTime
  additionally_insured_verified Boolean   @default(false)
  verified_by                   Int?
  created_at                    DateTime  @default(now())
  Vendor                        Vendors   @relation(fields: [vendor_id], references: [id])
  VerifiedBy                    Employees? @relation(fields: [verified_by], references: [id])

  @@index([vendor_id, expiration_date])
}

model VendorWarnings {
  id             Int       @id @default(autoincrement())
  vendor_id      Int
  notice_type    String
  pandadoc_id    String?
  status         String
  date_sent      DateTime?
  sent_by        Int
  date_completed DateTime?
  created_at     DateTime  @default(now())
  SentBy         Employees @relation(fields: [sent_by], references: [id])
  Vendor         Vendors   @relation(fields: [vendor_id], references: [id])

  @@index([vendor_id])
}
