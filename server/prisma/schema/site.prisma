model Sites {
  id               Int               @id(map: "PK__Sites__3213E83F412421E7") @default(autoincrement())
  store            String?           @db.VarChar(100)
  mailing_address  String?           @db.VarChar(150)
  mailing_address2 String?           @db.VarChar(150)
  mailing_city     String?           @db.VarChar(100)
  mailing_state    String?           @db.VarChar(50)
  mailing_zipcode  String?           @db.VarChar(10)
  lat              Decimal?
  lng              Decimal?
  client_id        Int
  company_id       Int?
  sandbox          Boolean           @default(false)
  created_at       DateTime          @default(now())

  status_id        Int?              @default(3)
  
  ContractSites    ContractSites[]
  Attachments      SiteAttachments[]
  Contacts         SiteContacts[]
    WorkOrders       WorkOrders[]

  Status           SiteStatuses?     @relation(fields: [status_id], references: [id])
  Client           Clients           @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "FK__Sites__client_id__40F9A68C")
  Company          Companies?        @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__Sites__company_i__41EDCAC5")
}

model SiteContacts {
  created_at      DateTime     @default(now())
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(100)
  email           String?      @db.VarChar(100)
  phone           String?      @db.VarChar(100)
  site_id         Int
  contact_role_id Int
  
  ContactRole     ContactRoles @relation(fields: [contact_role_id], references: [id], onUpdate: NoAction)
  Site            Sites        @relation(fields: [site_id], references: [id], onUpdate: NoAction)
}

model SiteAttachments {
  id           Int      @id @default(autoincrement())
  site_id      Int
  category     String
  blob_url     String   @db.VarChar(500)
  file_name    String   @db.VarChar(255)
  content_type String?  @db.VarChar(100)
  uploaded_by  Int?
  created_at   DateTime @default(now())
  Site         Sites    @relation(fields: [site_id], references: [id])
}

model SiteStatuses {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(30)
  description   String?         @db.VarChar(100)
  color         String?         @db.VarChar(8)

  ContractSites ContractSites[]
  Sites         Sites[]
}
