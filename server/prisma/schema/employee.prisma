model Employees {
  id                      Int                         @id(map: "PK__Employee__3213E83F5DB792B8") @default(autoincrement())
  ms_user_id              String                      @unique @db.VarChar(100)
  name                    String                      @db.VarChar(100)
  email                   String                      @db.VarChar(100)
  terminated              Boolean                     @default(false)
  ActivityLog             ActivityLog[]
  AuthoredNotes           Notes[]                     @relation("NoteAuthor")
  TaggedInNotes           NoteTaggedUsers[]           @relation("NoteTaggedUser")
  PandaDocUserToken       PandaDocUserTokens?
  RoleAssignments         RoleAssignments[]
  VerifiedCOIs            VendorCOIs[]
  SentComplianceDocs      VendorComplianceDocuments[]
  SentWarnings            VendorWarnings[]
  WorkOrderCommunications WorkOrderCommunications[]
  SentWorkOrderMSAs       WorkOrderMSAs[]
  MobilizationFeesCreated WorkOrderMobilizationFees[] @relation("MobilizationFeeCreatedBy")
  MobilizationFeesSent    WorkOrderMobilizationFees[] @relation("MobilizationFeeSentBy")
  MobilizationFeesPaid    WorkOrderMobilizationFees[] @relation("MobilizationFeePaidBy")
}

model InternalRoles {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  description     String?           @db.VarChar(100)
  RoleAssignments RoleAssignments[]
  RoleEntityType  RoleEntityTypes[]
}

model RoleAssignments {
  id               Int           @id @default(autoincrement())
  employee_id      Int
  internal_role_id Int
  entity_type_id   Int
  entity_id        Int
  created_at       DateTime      @default(now())
  Employee         Employees     @relation(fields: [employee_id], references: [id])
  Role             InternalRoles @relation(fields: [internal_role_id], references: [id])

  @@index([entity_type_id, entity_id])
  @@index([employee_id])
}

model PandaDocUserTokens {
  id            Int       @id @default(autoincrement())
  employee_id   Int       @unique
  access_token  String    @db.VarChar(2000)
  refresh_token String    @db.VarChar(2000)
  expires_at    DateTime
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  Employee      Employees @relation(fields: [employee_id], references: [id])
}

model RoleEntityTypes {
  id               Int           @id @default(autoincrement())
  internal_role_id Int
  entity_type_id   Int
  InternalRole     InternalRoles @relation(fields: [internal_role_id], references: [id])

  @@unique([internal_role_id, entity_type_id])
}
