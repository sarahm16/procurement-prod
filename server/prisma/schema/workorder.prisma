

model WorkOrders {
  created_at              DateTime                @default(now())
  start_date              DateTime?
  due_date                DateTime            @default(now())
  id                      Int                 @id(map: "PK__WorkOrde__3213E83FA1A0BFFC") @default(autoincrement())
  work_order_number       String              @unique @db.VarChar(20) // Internal NFC work order id
  created_by_email        String              @db.VarChar(100)
  type                    String              @db.VarChar(50)
  external_id             String?             @db.VarChar(50)
  scope_of_work           String?             @db.VarChar(1000)
  priority                String?              @db.VarChar(50)
  phase                   String?             @db.VarChar(10) @default("ops")

  parent_work_order_id    Int?                // null = parent work order or stand alone
  site_id                 Int
  status_id               Int
  vendor_id               Int?                // assigned vendor will be null when work order is created
  msa_id                  Int?                // msa will also be null when work order is created
  software_id             Int?

  Parent                  WorkOrders?         @relation("WorkOrderChildren", fields: [parent_work_order_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Children                WorkOrders[]        @relation("WorkOrderChildren")
  Site                    Sites               @relation(fields: [site_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__site___5E8A0973")
  Status                  WorkOrderStatuses   @relation(fields: [status_id], references: [id])
  Vendor                  Vendors?             @relation(fields: [vendor_id], references: [id])
  Software                Softwares?           @relation(fields: [software_id], references: [id])


  MSAs                    WorkOrderMSAs[]     // Only one MSA is valid at a time, but multiple versions can be sent if pricing is changed, vendor is changed, etc
  Services                WorkOrderServices[]
  Attachments             WorkOrderAttachments[]
  VendorUpdates           WorkOrderVendorUpdates[]     // work order will not have a vendor update on creation, and it may have multiple if a vendor is replaced with another vendor
  VendorCommunications    WorkOrderCommunications[]
}

model WorkOrderStatuses {
    id                     Int              @id @default(autoincrement())
    name                   String           @db.VarChar(30)
    description            String?          @db.VarChar(100)
    color                  String?          @db.VarChar(8)

    WorkOrders             WorkOrders[]
}

model WorkOrderServices {
  id                Int           @id(map: "PK__WorkOrde__3213E83FF413C92F") @default(autoincrement())
  
  work_order_id     Int
  trade_id          Int          // Trades list doubles as work order services list

  client_price      Decimal?      @db.Decimal(10, 2)
  vendor_price      Decimal?      @db.Decimal(10, 2)
  is_upsell         Boolean       @default(false, map: "DF__WorkOrder__is_up__634EBE90")
  
  WorkOrder         WorkOrders    @relation(fields: [work_order_id], references: [id], onUpdate: NoAction, map: "FK__WorkOrder__work___6442E2C9")
  Service           Trades        @relation(fields: [trade_id], references: [id])                
}

model WorkOrderMSAs {
  id             Int       @id @default(autoincrement())
  work_order_id  Int       // the job this MSA is for
  vendor_id      Int       // the vendor the msa was sent to

  pandadoc_id    String?
  status         String
  date_sent      DateTime?
  date_completed DateTime?
  sent_by        Int
  created_at     DateTime        @default(now())

  WorkOrder      WorkOrders?     @relation(fields: [work_order_id], references: [id])
  SentBy         Employees       @relation(fields: [sent_by], references: [id])
  Vendor         Vendors         @relation(fields: [vendor_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model WorkOrderAttachments {
  id             Int       @id @default(autoincrement())
  work_order_id  Int
  category       String    // "pre_work" | "vendor_before" | "vendor_after" | "attachment"
  blob_url       String    @db.VarChar(500)
  file_name      String    @db.VarChar(255)
  content_type   String?   @db.VarChar(100)
  uploaded_by    Int?      // employee (null if vendor-uploaded via portal)
  uploaded_by_vendor Boolean @default(false)
  created_at     DateTime  @default(now())

  WorkOrder      WorkOrders @relation(fields: [work_order_id], references: [id])
}

model WorkOrderVendorUpdates {
  id                Int           @id @default(autoincrement())
  created_at        DateTime      @default(now())
  check_in          DateTime?
  check_in_notes    String?       @db.VarChar(1000)
  check_out         DateTime? 
  check_out_notes   String?       @db.VarChar(1000)

  vendor_id         Int
  work_order_id     Int

  Vendor            Vendors         @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  WorkOrder         WorkOrders      @relation(fields: [work_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([work_order_id, vendor_id])    // One check in and one check out per vendor per work order
}

model WorkOrderCommunications {
  id             Int        @id @default(autoincrement())
  work_order_id  Int
  content        String     @db.VarChar(2000)
  sender_type    String     // "internal" | "vendor"
  employee_id    Int?       // set when sender_type = internal (who on our team)
  vendor_id      Int?       // set when sender_type = vendor
  created_at     DateTime   @default(now())

  WorkOrder      WorkOrders @relation(fields: [work_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Employee       Employees? @relation(fields: [employee_id], references: [id])
  Vendor         Vendors?   @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([work_order_id])
}